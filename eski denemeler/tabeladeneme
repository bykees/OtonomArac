import os

import cv2
import numpy as np


class TabelaAlgilayici:
    def __init__(self, camera_index=0, debug=True):
        self.camera_index = camera_index
        self.DEBUG = debug
        self.base_dir = os.path.dirname(os.path.abspath(__file__))

        self.WIDTH = 640
        self.HEIGHT = 480
        self.template_size = (128, 128)
        self.templates = {}

        self.last_label = "YOK"
        self.label_count = 0
        self.confirm_frames = 3
        self.min_match_score = 0.42
        self.rule_match_score = 0.35
        self.symbol_smooth_alpha = 0.45
        self.box_smooth_alpha = 0.35
        self.max_missed_frames = 6
        self.last_box = None
        self.last_kind = "YOK"
        self.last_symbol = None
        self.symbol_ema = None
        self.missed_frames = 0
        self.last_score = 0.0
        self.score_ema = 0.0
        self.mask_min_area_ratio = 0.0025

    def normalize_image(self, img):
        if img is None:
            return None

        if len(img.shape) == 3 and img.shape[2] == 4:
            alpha = img[:, :, 3].astype(np.float32) / 255.0
            bgr = img[:, :, :3].astype(np.float32)
            white = np.full_like(bgr, 255, dtype=np.float32)
            merged = bgr * alpha[:, :, None] + white * (1.0 - alpha[:, :, None])
            return merged.astype(np.uint8)

        return img

    def create_red_mask(self, hsv):
        lower_red1 = np.array([0, 70, 60])
        upper_red1 = np.array([12, 255, 255])
        lower_red2 = np.array([165, 70, 60])
        upper_red2 = np.array([179, 255, 255])

        mask1 = cv2.inRange(hsv, lower_red1, upper_red1)
        mask2 = cv2.inRange(hsv, lower_red2, upper_red2)
        return cv2.bitwise_or(mask1, mask2)

    def create_blue_mask(self, hsv):
        lower_blue = np.array([90, 70, 50])
        upper_blue = np.array([135, 255, 255])
        return cv2.inRange(hsv, lower_blue, upper_blue)

    def create_white_mask(self, hsv):
        lower_white = np.array([0, 0, 140])
        upper_white = np.array([179, 80, 255])
        return cv2.inRange(hsv, lower_white, upper_white)

    def keep_large_components(self, mask, min_area):
        num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, 8)
        filtered = np.zeros_like(mask)

        for label_idx in range(1, num_labels):
            area = stats[label_idx, cv2.CC_STAT_AREA]
            if area >= min_area:
                filtered[labels == label_idx] = 255

        return filtered

    def filter_mask_by_area(self, mask, min_area):
        return self.keep_large_components(mask, min_area=max(1, int(min_area)))

    def normalize_symbol_mask(self, mask):
        if mask is None or cv2.countNonZero(mask) == 0:
            return mask

        coords = cv2.findNonZero(mask)
        x, y, w, h = cv2.boundingRect(coords)
        cropped = mask[y:y + h, x:x + w]

        target_w, target_h = self.template_size
        scale = min((target_w - 12) / max(w, 1), (target_h - 12) / max(h, 1))
        new_w = max(1, int(w * scale))
        new_h = max(1, int(h * scale))
        resized = cv2.resize(cropped, (new_w, new_h), interpolation=cv2.INTER_NEAREST)

        normalized = np.zeros((target_h, target_w), dtype=np.uint8)
        x_offset = (target_w - new_w) // 2
        y_offset = (target_h - new_h) // 2
        normalized[y_offset:y_offset + new_h, x_offset:x_offset + new_w] = resized
        return normalized

    def smooth_box(self, new_box):
        if new_box is None:
            return self.last_box

        if self.last_box is None:
            self.last_box = tuple(int(v) for v in new_box)
            return self.last_box

        smoothed = []
        for old_val, new_val in zip(self.last_box, new_box):
            value = self.box_smooth_alpha * new_val + (1.0 - self.box_smooth_alpha) * old_val
            smoothed.append(int(value))

        self.last_box = tuple(smoothed)
        return self.last_box

    def smooth_symbol(self, symbol):
        if symbol is None:
            if self.symbol_ema is None:
                return self.last_symbol

            self.symbol_ema *= 0.85
            faded = np.where(self.symbol_ema >= 127, 255, 0).astype(np.uint8)
            if cv2.countNonZero(faded) == 0:
                self.symbol_ema = None
                self.last_symbol = None
                return None

            self.last_symbol = faded
            return faded

        symbol = symbol.astype(np.float32)
        if self.symbol_ema is None:
            self.symbol_ema = symbol.copy()
        else:
            self.symbol_ema = (
                self.symbol_smooth_alpha * symbol
                + (1.0 - self.symbol_smooth_alpha) * self.symbol_ema
            )

        stable = np.where(self.symbol_ema >= 127, 255, 0).astype(np.uint8)
        self.last_symbol = stable
        return stable

    def build_symbol_descriptor(self, mask):
        if mask is None or cv2.countNonZero(mask) == 0:
            return None

        binary = (mask > 0).astype(np.float32)
        total_ratio = float(np.mean(binary))
        row_profile = np.mean(binary, axis=1)
        col_profile = np.mean(binary, axis=0)

        row_bins = np.array_split(row_profile, 8)
        col_bins = np.array_split(col_profile, 8)
        row_features = np.array(
            [float(np.mean(chunk)) for chunk in row_bins], dtype=np.float32
        )
        col_features = np.array(
            [float(np.mean(chunk)) for chunk in col_bins], dtype=np.float32
        )

        h, w = binary.shape
        top_half = float(np.mean(binary[: h // 2, :]))
        bottom_half = float(np.mean(binary[h // 2 :, :]))
        left_half = float(np.mean(binary[:, : w // 2]))
        right_half = float(np.mean(binary[:, w // 2 :]))
        center_box = float(np.mean(binary[h // 4 : 3 * h // 4, w // 4 : 3 * w // 4]))

        return {
            "total_ratio": total_ratio,
            "row_features": row_features,
            "col_features": col_features,
            "top_half": top_half,
            "bottom_half": bottom_half,
            "left_half": left_half,
            "right_half": right_half,
            "center_box": center_box,
        }

    def compare_descriptors(self, symbol_desc, template_desc):
        if symbol_desc is None or template_desc is None:
            return 0.0

        row_diff = float(
            np.mean(np.abs(symbol_desc["row_features"] - template_desc["row_features"]))
        )
        col_diff = float(
            np.mean(np.abs(symbol_desc["col_features"] - template_desc["col_features"]))
        )
        total_diff = abs(symbol_desc["total_ratio"] - template_desc["total_ratio"])
        top_bottom_diff = abs(
            (symbol_desc["top_half"] - symbol_desc["bottom_half"])
            - (template_desc["top_half"] - template_desc["bottom_half"])
        )
        left_right_diff = abs(
            (symbol_desc["left_half"] - symbol_desc["right_half"])
            - (template_desc["left_half"] - template_desc["right_half"])
        )
        center_diff = abs(symbol_desc["center_box"] - template_desc["center_box"])

        weighted_diff = (
            0.30 * row_diff
            + 0.30 * col_diff
            + 0.15 * total_diff
            + 0.10 * top_bottom_diff
            + 0.10 * left_right_diff
            + 0.05 * center_diff
        )
        return max(0.0, 1.0 - weighted_diff * 3.0)

    def infer_label_from_rules(self, symbol_desc, sign_kind):
        if sign_kind != "warning_triangle" or symbol_desc is None:
            return "YOK", 0.0

        row = symbol_desc["row_features"]
        col = symbol_desc["col_features"]
        bottom_bias = symbol_desc["bottom_half"] - symbol_desc["top_half"]
        center_strength = symbol_desc["center_box"]
        total_ratio = symbol_desc["total_ratio"]
        middle_rows = float(np.mean(row[4:7]))
        top_rows = float(np.mean(row[:3]))
        edge_cols = float((col[0] + col[1] + col[-2] + col[-1]) / 4.0)
        center_cols = float(np.mean(col[2:6]))

        # "Kasis" benzeri uyarı işareti: alt bölüm ağırlıklı, merkezde kuvvetli,
        # yatay olarak geniş ama kenarlara çok taşmayan koyu alan.
        if (
            0.04 <= total_ratio <= 0.22
            and bottom_bias > 0.06
            and middle_rows > top_rows * 2.5
            and center_strength > 0.10
            and center_cols > edge_cols * 1.8
        ):
            confidence = min(
                0.75,
                0.45
                + 0.8 * min(0.12, bottom_bias)
                + 0.6 * min(0.18, center_strength),
            )
            return "kasis", confidence

        return "YOK", 0.0

    def smooth_score(self, score):
        self.score_ema = 0.4 * score + 0.6 * self.score_ema
        self.last_score = self.score_ema
        return self.last_score

    def infer_sign_kind(self, img):
        img = self.normalize_image(img)
        hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

        red_pixels = cv2.countNonZero(self.create_red_mask(hsv))
        blue_pixels = cv2.countNonZero(self.create_blue_mask(hsv))

        if red_pixels > blue_pixels and red_pixels > 300:
            return "warning_triangle"
        if blue_pixels > 300:
            return "mandatory_blue"
        return "unknown"

    def load_templates(self, template_folder="templates"):
        if not os.path.isabs(template_folder):
            template_folder = os.path.join(self.base_dir, template_folder)

        if not os.path.isdir(template_folder):
            raise FileNotFoundError(
                f"Template klasoru bulunamadi: {template_folder}"
            )

        for file_name in os.listdir(template_folder):
            path = os.path.join(template_folder, file_name)

            if not file_name.lower().endswith((".png", ".jpg", ".jpeg")):
                continue

            label = os.path.splitext(file_name)[0]
            img = cv2.imread(path, cv2.IMREAD_UNCHANGED)
            if img is None:
                continue

            img = self.normalize_image(img)
            sign_kind = self.infer_sign_kind(img)
            symbol = self.prepare_symbol(img, sign_kind)

            if symbol is None:
                continue

            self.templates[label] = {
                "kind": sign_kind,
                "symbol": symbol,
                "descriptor": self.build_symbol_descriptor(symbol),
            }

        print("Yuklenen tabelalar:", list(self.templates.keys()))

    def prepare_symbol(self, img, sign_kind):
        img = cv2.resize(img, self.template_size)
        hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        blur = cv2.GaussianBlur(gray, (5, 5), 0)

        if sign_kind == "warning_triangle":
            binary = self.extract_warning_symbol(img)
        else:
            _, binary = cv2.threshold(
                blur, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU
            )
            white_ratio = np.sum(binary == 255) / binary.size
            if white_ratio > 0.7:
                binary = cv2.bitwise_not(binary)

        if binary is None:
            return None

        kernel = np.ones((3, 3), np.uint8)
        binary = cv2.morphologyEx(binary, cv2.MORPH_OPEN, kernel)
        binary = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)
        return binary

    def extract_warning_symbol(self, img):
        img = cv2.resize(img, self.template_size)
        hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        blur = cv2.GaussianBlur(gray, (5, 5), 0)
        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
        enhanced = clahe.apply(blur)
        red_mask = self.create_red_mask(hsv)
        white_mask = self.create_white_mask(hsv)

        contours, _ = cv2.findContours(
            red_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        if not contours:
            return None

        outer = max(contours, key=cv2.contourArea)
        outer_mask = np.zeros_like(red_mask)
        hull = cv2.convexHull(outer)
        cv2.drawContours(outer_mask, [hull], -1, 255, thickness=cv2.FILLED)

        inner_candidates = cv2.bitwise_and(white_mask, outer_mask)
        inner_candidates = cv2.bitwise_and(
            inner_candidates, cv2.bitwise_not(red_mask)
        )
        kernel = np.ones((3, 3), np.uint8)
        inner_candidates = cv2.morphologyEx(
            inner_candidates, cv2.MORPH_OPEN, kernel
        )
        inner_candidates = cv2.morphologyEx(
            inner_candidates, cv2.MORPH_CLOSE, kernel
        )

        inner_contours, _ = cv2.findContours(
            inner_candidates, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        inner_region = None
        if inner_contours:
            largest_inner = max(inner_contours, key=cv2.contourArea)
            if cv2.contourArea(largest_inner) > 150:
                inner_region = np.zeros_like(red_mask)
                cv2.drawContours(
                    inner_region, [largest_inner], -1, 255, thickness=cv2.FILLED
                )

        if inner_region is None:
            inner_region = cv2.bitwise_and(outer_mask, cv2.bitwise_not(red_mask))

        inner_region = cv2.erode(inner_region, np.ones((5, 5), np.uint8), iterations=1)
        inner_pixels = enhanced[inner_region > 0]
        if inner_pixels.size == 0:
            return None

        mean_val = float(np.mean(inner_pixels))
        std_val = float(np.std(inner_pixels))
        threshold_val = int(max(0, min(255, mean_val - 0.55 * std_val - 18)))

        _, dark_mask = cv2.threshold(
            enhanced, threshold_val, 255, cv2.THRESH_BINARY_INV
        )
        symbol = cv2.bitwise_and(dark_mask, inner_region)

        symbol[:4, :] = 0
        symbol[-4:, :] = 0
        symbol[:, :4] = 0
        symbol[:, -4:] = 0

        symbol = cv2.morphologyEx(symbol, cv2.MORPH_OPEN, kernel)
        symbol = cv2.morphologyEx(symbol, cv2.MORPH_CLOSE, kernel)
        symbol = self.keep_large_components(
            symbol, min_area=max(18, int(np.count_nonzero(inner_region) * 0.015))
        )

        if cv2.countNonZero(symbol) == 0:
            fallback_threshold = int(max(0, min(255, mean_val - 8)))
            _, dark_mask = cv2.threshold(
                enhanced, fallback_threshold, 255, cv2.THRESH_BINARY_INV
            )
            symbol = cv2.bitwise_and(dark_mask, inner_region)
            symbol = cv2.morphologyEx(symbol, cv2.MORPH_OPEN, kernel)
            symbol = cv2.morphologyEx(symbol, cv2.MORPH_CLOSE, kernel)
            symbol = self.keep_large_components(
                symbol, min_area=max(12, int(np.count_nonzero(inner_region) * 0.01))
            )

        return self.normalize_symbol_mask(symbol)

    def is_warning_triangle(self, contour):
        area = cv2.contourArea(contour)
        if area < 700:
            return False

        peri = cv2.arcLength(contour, True)
        approx = cv2.approxPolyDP(contour, 0.04 * peri, True)
        x, y, w, h = cv2.boundingRect(contour)
        hull_area = cv2.contourArea(cv2.convexHull(contour))
        solidity = area / hull_area if hull_area > 0 else 0
        aspect_ratio = w / float(h)

        if len(approx) < 3 or len(approx) > 8:
            return False
        if aspect_ratio < 0.6 or aspect_ratio > 1.4:
            return False
        if solidity < 0.75:
            return False
        return True

    def find_sign_candidates(self, frame):
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        kernel = np.ones((5, 5), np.uint8)
        frame_area = frame.shape[0] * frame.shape[1]

        red_mask = self.create_red_mask(hsv)
        blue_mask = self.create_blue_mask(hsv)

        red_mask = cv2.morphologyEx(red_mask, cv2.MORPH_OPEN, kernel)
        red_mask = cv2.morphologyEx(red_mask, cv2.MORPH_CLOSE, kernel)
        blue_mask = cv2.morphologyEx(blue_mask, cv2.MORPH_OPEN, kernel)
        blue_mask = cv2.morphologyEx(blue_mask, cv2.MORPH_CLOSE, kernel)
        red_mask = self.filter_mask_by_area(
            red_mask, min_area=frame_area * self.mask_min_area_ratio
        )
        blue_mask = self.filter_mask_by_area(
            blue_mask, min_area=frame_area * (self.mask_min_area_ratio * 0.7)
        )

        candidates = []
        debug_mask = np.zeros_like(red_mask)
        frame_center_x = frame.shape[1] // 2

        red_contours, _ = cv2.findContours(
            red_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        for cnt in red_contours:
            if not self.is_warning_triangle(cnt):
                continue

            x, y, w, h = cv2.boundingRect(cnt)
            if y > int(frame.shape[0] * 0.85):
                continue
            if w * h < frame_area * 0.015:
                continue

            center_x = x + w // 2
            center_distance_ratio = abs(center_x - frame_center_x) / float(frame.shape[1])
            if center_distance_ratio > 0.42:
                continue

            candidates.append((x, y, w, h, "warning_triangle"))
            cv2.drawContours(debug_mask, [cnt], -1, 255, thickness=cv2.FILLED)

        blue_contours, _ = cv2.findContours(
            blue_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        for cnt in blue_contours:
            area = cv2.contourArea(cnt)
            if area < 700:
                continue

            x, y, w, h = cv2.boundingRect(cnt)
            aspect_ratio = w / float(h)
            if aspect_ratio < 0.7 or aspect_ratio > 1.3:
                continue
            if y > int(frame.shape[0] * 0.85):
                continue
            if w * h < frame_area * 0.01:
                continue

            candidates.append((x, y, w, h, "mandatory_blue"))
            cv2.drawContours(debug_mask, [cnt], -1, 255, thickness=cv2.FILLED)

        return candidates, debug_mask

    def extract_inner_symbol(self, roi, sign_kind):
        if roi is None or roi.size == 0:
            return None

        roi = self.normalize_image(roi)
        roi = cv2.resize(roi, (self.template_size[0] * 2, self.template_size[1] * 2))

        if sign_kind == "warning_triangle":
            binary = self.extract_warning_symbol(roi)
        else:
            gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
            blur = cv2.GaussianBlur(gray, (5, 5), 0)
            _, binary = cv2.threshold(
                blur, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU
            )
            white_ratio = np.sum(binary == 255) / binary.size
            if white_ratio > 0.7:
                binary = cv2.bitwise_not(binary)

        if binary is None:
            return None

        kernel = np.ones((3, 3), np.uint8)
        binary = cv2.morphologyEx(binary, cv2.MORPH_OPEN, kernel)
        binary = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)
        return self.normalize_symbol_mask(binary)

    def compare_with_templates(self, symbol_img, sign_kind):
        best_label = "YOK"
        best_score = -1
        symbol_desc = self.build_symbol_descriptor(symbol_img)

        for label, template_info in self.templates.items():
            if template_info["kind"] != sign_kind:
                continue

            template_symbol = template_info["symbol"]
            if template_symbol.shape != symbol_img.shape:
                continue

            descriptor_score = self.compare_descriptors(
                symbol_desc, template_info.get("descriptor")
            )
            diff = cv2.bitwise_xor(symbol_img, template_symbol)
            xor_score = 1.0 - (np.sum(diff == 255) / diff.size)
            score = 0.75 * descriptor_score + 0.25 * xor_score

            if score > best_score:
                best_score = score
                best_label = label

        rule_label, rule_score = self.infer_label_from_rules(symbol_desc, sign_kind)
        if rule_score > best_score:
            best_label = rule_label
            best_score = rule_score

        return best_label, best_score

    def stabilize_label(self, label):
        if label == self.last_label:
            self.label_count += 1
        else:
            self.last_label = label
            self.label_count = 1

        if self.label_count >= self.confirm_frames:
            return self.last_label
        return "YOK"

    def detect_sign(self, frame):
        candidates, mask = self.find_sign_candidates(frame)

        best_label = "YOK"
        best_score = 0
        best_box = None
        best_symbol = None
        best_kind = "YOK"
        best_candidate_area = 0

        for (x, y, w, h, sign_kind) in candidates:
            roi = frame[y:y + h, x:x + w]
            symbol = self.extract_inner_symbol(roi, sign_kind)
            if symbol is None:
                continue

            candidate_area = w * h
            if candidate_area > best_candidate_area:
                best_candidate_area = candidate_area
                best_box = (x, y, w, h)
                best_symbol = symbol
                best_kind = sign_kind

            label, score = self.compare_with_templates(symbol, sign_kind)
            if score > best_score and score > self.min_match_score:
                best_score = score
                best_label = label
                best_box = (x, y, w, h)
                best_symbol = symbol
                best_kind = sign_kind

        if best_box is not None:
            self.missed_frames = 0
            best_box = self.smooth_box(best_box)
            best_symbol = self.smooth_symbol(best_symbol)
            self.last_kind = best_kind
        else:
            self.missed_frames += 1
            if self.missed_frames <= self.max_missed_frames:
                best_box = self.last_box
                best_symbol = self.smooth_symbol(None)
                best_kind = self.last_kind
            else:
                self.last_box = None
                self.last_kind = "YOK"
                best_symbol = self.smooth_symbol(None)
                best_kind = "YOK"

        final_label = self.stabilize_label(best_label) if best_label != "YOK" else "YOK"
        if best_label != "YOK":
            best_score = self.smooth_score(best_score)
        else:
            best_score = self.smooth_score(0.0)

        return final_label, best_box, mask, best_symbol, best_score, best_kind

    def run(self):
        cap = cv2.VideoCapture(self.camera_index, cv2.CAP_DSHOW)
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, self.WIDTH)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, self.HEIGHT)

        if not cap.isOpened():
            print("Kamera acilamadi.")
            return

        while True:
            ret, frame = cap.read()
            if not ret:
                break

            frame = cv2.resize(frame, (self.WIDTH, self.HEIGHT))
            label, box, mask, symbol, score, sign_kind = self.detect_sign(frame)

            if box is not None:
                x, y, w, h = box
                cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 255), 2)
                roi_text = f"ROI: {sign_kind}"
                cv2.putText(
                    frame,
                    roi_text,
                    (x, max(20, y - 32)),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (0, 255, 255),
                    2,
                )
                cv2.putText(
                    frame,
                    f"{label} {score:.2f}",
                    (x, y - 10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (0, 255, 255),
                    2,
                )

                if symbol is not None and cv2.countNonZero(symbol) > 0:
                    preview_size = 96
                    symbol_preview = cv2.resize(
                        symbol, (preview_size, preview_size), interpolation=cv2.INTER_NEAREST
                    )
                    symbol_preview = cv2.cvtColor(symbol_preview, cv2.COLOR_GRAY2BGR)
                    px1 = min(self.WIDTH - preview_size - 10, x + w + 10)
                    py1 = max(10, y)
                    px2 = px1 + preview_size
                    py2 = py1 + preview_size

                    if px1 >= 0 and py1 >= 0 and px2 <= self.WIDTH and py2 <= self.HEIGHT:
                        frame[py1:py2, px1:px2] = symbol_preview
                        cv2.rectangle(frame, (px1, py1), (px2, py2), (255, 255, 255), 1)
                        cv2.putText(
                            frame,
                            "Ic Sembol",
                            (px1, max(15, py1 - 6)),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.45,
                            (255, 255, 255),
                            1,
                        )

            cv2.putText(
                frame,
                f"Tabela: {label}",
                (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0, 255, 255),
                2,
            )

            cv2.imshow("Kamera", frame)
            cv2.imshow("Tabela Maskesi", mask)

            key = cv2.waitKey(1) & 0xFF
            if key == 27 or key == ord("q"):
                break

        cap.release()
        cv2.destroyAllWindows()


